 #define EQZ_BAND_VALUE_SIZE 12
 
+/* Call with the player lock held: retain every unrelated filter token. */
+static int rd_set_filter(libvlc_media_player_t *mp, const char *name, bool enabled)
+{
+    char *old = var_GetString(mp, "audio-filter");
+    if (!old) return -1;
+    char *updated = malloc(strlen(old) + strlen(name) + 2);
+    if (!updated) { free(old); return -1; }
+    updated[0] = '\0';
+    char *cursor = old, *token;
+    while ((token = strsep(&cursor, " :")) != NULL) {
+        if (!*token || !strcmp(token, name)) continue;
+        if (*updated) strcat(updated, ":");
+        strcat(updated, token);
+    }
+    if (enabled) {
+        if (*updated) strcat(updated, ":");
+        strcat(updated, name);
+    }
+    int ret = var_SetString(mp, "audio-filter", updated);
+    audio_output_t *aout = vlc_player_aout_Hold(mp->player);
+    if (aout) {
+        if (ret == VLC_SUCCESS) ret = var_SetString(aout, "audio-filter", updated);
+        aout_Release(aout);
+    }
+    free(updated);
+    free(old);
+    return ret == VLC_SUCCESS ? 0 : -1;
+}
+
+bool libvlc_media_player_noise_reduction_available(libvlc_media_player_t *mp)
+{
+    vlc_player_Lock(mp->player);
+    bool ready = var_GetBool(mp, "rd-rnnoise-prepared");
+    if (ready && vlc_player_IsStarted(mp->player)) {
+        audio_output_t *aout = vlc_player_aout_Hold(mp->player);
+        ready = aout && var_GetBool(aout, "rd-rnnoise-active");
+        if (aout) aout_Release(aout);
+    }
+    vlc_player_Unlock(mp->player);
+    return ready;
+}
+
+int libvlc_media_player_prepare_noise_reduction(libvlc_media_player_t *mp)
+{
+    vlc_player_Lock(mp->player);
+    int ret = 0;
+    if (!var_GetBool(mp, "rd-rnnoise-prepared")) {
+        if (vlc_player_IsStarted(mp->player) || !module_exists("rnnoise"))
+            ret = -1;
+        else {
+            ret = rd_set_filter(mp, "rnnoise", true);
+            if (!ret) var_SetBool(mp, "rd-rnnoise-prepared", true);
+        }
+    }
+    vlc_player_Unlock(mp->player);
+    return ret;
+}
+
+int libvlc_media_player_set_noise_reduction(libvlc_media_player_t *mp, bool enabled)
+{
+    vlc_player_Lock(mp->player);
+    if (!var_GetBool(mp, "rd-rnnoise-prepared")) {
+        vlc_player_Unlock(mp->player);
+        return -1;
+    }
+    int ret = var_SetBool(mp, "rd-rnnoise-enabled", enabled);
+    audio_output_t *aout = vlc_player_aout_Hold(mp->player);
+    if (aout) {
+        if (ret == VLC_SUCCESS) ret = var_SetBool(aout, "rd-rnnoise-enabled", enabled);
+        aout_Release(aout);
+    }
+    vlc_player_Unlock(mp->player);
+    return ret == VLC_SUCCESS ? 0 : -1;
+}
