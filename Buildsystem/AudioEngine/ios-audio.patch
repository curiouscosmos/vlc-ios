diff --git a/extras/package/apple/build.sh b/extras/package/apple/build.sh
index 90e5893..17fdb49 100755
--- a/extras/package/apple/build.sh
+++ b/extras/package/apple/build.sh
@@ -878,6 +878,21 @@ for module in "${VLC_MODULE_REMOVAL_LIST[@]}"; do
         -exec rm '{}' \;
 done
 
+if [ "$VLC_HOST_OS" = "ios" ]; then
+    # Only audio codecs and still-image loaders may enter the static module table.
+    plugins="$VLC_INSTALL_DIR/lib/vlc/plugins"
+    for category in video_output video_filter video_chroma video_splitter spu text_renderer visualization; do
+        rm -rf "$plugins/$category"
+    done
+    find "$plugins/codec" -name '*.a' -print0 |
+    while IFS= read -r -d '' archive; do
+        case "${archive##*/}" in
+            libadpcm_plugin.a|libaes3_plugin.a|libaraw_plugin.a|libaudiotoolboxmidi_plugin.a|libavcodec_plugin.a|libfaad_plugin.a|libfdkaac_plugin.a|libflac_plugin.a|libfluidsynth_plugin.a|libg711_plugin.a|libjpeg_plugin.a|liblpcm_plugin.a|libmad_plugin.a|libmpg123_plugin.a|libopus_plugin.a|libpng_plugin.a|libspdif_plugin.a|libspeex_plugin.a|libsvgdec_plugin.a|libtremor_plugin.a|libtwolame_plugin.a|libuleaddvaudio_plugin.a|libvorbis_plugin.a|libxwd_plugin.a) ;;
+            *) rm "$archive" || exit 1 ;;
+        esac
+    done || abort_err "Failed to prune iOS codec modules"
+fi
+
 echo ""
 
