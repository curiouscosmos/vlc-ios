+MESONBUILD = meson compile -j4 -C $(BUILD_DIR) $(MESON_BUILD) $(MESONCOMPILEFLAGS) && meson install --no-rebuild -C $(BUILD_DIR)
 
 # shared Qt config
 ifeq ($(call system_tool_majmin, qmake6 -query QT_VERSION 2>/dev/null),$(QTBASE_VERSION_MAJOR))
